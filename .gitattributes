# Git LFS — arquivos grandes
# Tudo que estiver dentro da pasta "DLSS 5 Files" vai para o LFS automaticamente
# ([[:space:]] é como o git representa os espaços do nome da pasta):
DLSS[[:space:]]5[[:space:]]Files/** filter=lfs diff=lfs merge=lfs -text

# Exceção: texto do kit fica FORA do LFS. São poucos KB, dá para ler direto no
# GitHub, e não consome cota. Regras posteriores vencem as anteriores.
DLSS[[:space:]]5[[:space:]]Files/**/*.txt !filter !diff !merge text
DLSS[[:space:]]5[[:space:]]Files/**/*.md !filter !diff !merge text

# Extensões de binários grandes, em qualquer lugar do repositório:
*.dll filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text

# Exceção: a pasta MGSV do kit guarda o patcher anti-hook do Phantom Pain, um exe de
# poucos KB com o código-fonte junto. Fica fora do LFS (regras posteriores vencem).
DLSS[[:space:]]5[[:space:]]Files/MGSV/** !filter !diff !merge -text

# O patcher anti-hook do MGS V tem 189 KB: fica FORA do LFS (regra posterior vence),
# para entrar no repositório como arquivo comum e sair inteiro em qualquer download.
DLSS[[:space:]]5[[:space:]]Files/MGSV/** !filter !diff !merge -text
DLSS[[:space:]]5[[:space:]]Files/MGSV/*.txt !filter !diff !merge text
DLSS[[:space:]]5[[:space:]]Files/MGSV/*.md !filter !diff !merge text
DLSS[[:space:]]5[[:space:]]Files/MGSV/*.cpp !filter !diff !merge text
